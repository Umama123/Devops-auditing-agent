# Copy this file to .env and fill in your own values. Never commit .env.

# Which LLM provider to use: gemini (default) or openai (any OpenAI-compatible API)
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=
# One model, or several separated by commas (used as automatic fallbacks on quota/overload)
GEMINI_MODEL=gemini-3.5-flash

# --- OpenAI-compatible (OpenAI, Groq, OpenRouter, DeepSeek, Ollama, ...) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Leave empty for api.openai.com, otherwise e.g. https://api.groq.com/openai/v1
OPENAI_BASE_URL=

# Minimum seconds between API calls (keeps free tiers under their per-minute limit).
# Default: 6 for gemini, 1 for openai. Set 0 if you have a paid/high-quota key.
LLM_MIN_INTERVAL=

# Max characters of each tool output sent to the LLM. Lower it (e.g. 3000) for providers
# with small tokens-per-minute limits (like Groq's free tier).
TOOL_OUTPUT_MAX_CHARS=8000
